[Unit]
Description=WPCloud Control Panel Server (FastAPI + Asyncio)
After=network.target

[Service]
Type=simple
User=wpc
Group=wpc
WorkingDirectory=/opt/wpc
Environment=PYTHONPATH=/opt/wpc
ExecStart=/bin/bash /opt/wpc/scripts/wpc-service.sh
Restart=always
RestartSec=3
LimitNOFILE=65535
StandardOutput=append:/var/log/wpc.log
StandardError=append:/var/log/wpc.log

[Install]
WantedBy=multi-user.target
