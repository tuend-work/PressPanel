[Unit]
Description=WPCloud Control Panel Server (FastAPI + Asyncio)
After=network.target

[Service]
Type=simple
User=wpc
Group=wpc
WorkingDirectory=/opt/wpc
Environment=PYTHONPATH=/opt/wpc
ExecStart=/opt/wpc/venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8888 --workers 2
Restart=always
RestartSec=5
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
