#!/usr/bin/env bash
# ==============================================================================
# WPCloud Control Panel CLI Management Tool
# Cài đặt tại: /usr/local/bin/wpc
# Cách dùng: wpc <update|reinstall|status|restart|stop|start|logs|version|password|port>
# ==============================================================================

set -euo pipefail

INSTALL_DIR="/opt/wpc"
CONF_FILE="$INSTALL_DIR/conf/wpc.conf"

function show_help() {
    echo "=========================================================="
    echo "     WPCLOUD CONTROL PANEL CLI - ĐIỀU KHIỂN HỆ THỐNG     "
    echo "=========================================================="
    echo "Sử dụng: wpc <lệnh> [tham số]"
    echo ""
    echo "Các lệnh hỗ trợ:"
    echo "  update      - Cập nhật panel lên phiên bản mới nhất từ GitHub"
    echo "  reinstall   - Cài đặt lại toàn bộ panel (tự động sao lưu dữ liệu)"
    echo "  status      - Xem trạng thái dịch vụ panel"
    echo "  restart     - Khởi động lại dịch vụ panel"
    echo "  start       - Bật dịch vụ panel"
    echo "  stop        - Dừng dịch vụ panel"
    echo "  logs        - Theo dõi nhật ký hoạt động thời gian thực"
    echo "  version     - Xem phiên bản hiện tại của WPCloud Panel"
    echo "  password    - Đổi mật khẩu tài khoản quản trị admin"
    echo "  port <số>   - Đổi cổng truy cập panel (tránh trùng cổng khác)"
    echo "  fix-perms   - Khóa chặt quyền 0750 toàn bộ /home/* chống user xem trộm file nhau"
    echo "  help        - Hiển thị menu hướng dẫn này"
    echo "=========================================================="
}

ACTION="${1:-help}"

case "$ACTION" in
    update)
        TMP_RUNNER=$(mktemp /tmp/wpc_update_runner_XXXXXX.sh 2>/dev/null || echo "/tmp/wpc_update_$$.sh")
        cp "$INSTALL_DIR/scripts/update.sh" "$TMP_RUNNER" 2>/dev/null || true
        chmod 700 "$TMP_RUNNER" 2>/dev/null || true
        sudo bash "$TMP_RUNNER"
        rm -f "$TMP_RUNNER" 2>/dev/null || true
        ;;
    reinstall)
        sudo bash "$INSTALL_DIR/scripts/reinstall.sh"
        ;;
    status)
        sudo systemctl status wpc
        ;;
    restart)
        echo "[+] Đang khởi động lại dịch vụ WPCloud Control Panel (wpc.service)..."
        sudo systemctl restart wpc
        echo "[+] Hoàn tất! Trạng thái: $(systemctl is-active wpc)"
        ;;
    start)
        echo "[+] Đang bật dịch vụ WPCloud Control Panel (wpc.service)..."
        sudo systemctl start wpc
        echo "[+] Hoàn tất! Trạng thái: $(systemctl is-active wpc)"
        ;;
    stop)
        echo "[+] Đang dừng dịch vụ WPCloud Control Panel (wpc.service)..."
        sudo systemctl stop wpc 2>/dev/null || true
        echo "[+] Hoàn tất!"
        ;;
    logs)
        sudo journalctl -u wpc -f
        ;;
    version)
        if [ -f "$INSTALL_DIR/VERSION" ]; then
            echo "WPCloud Control Panel Version: $(cat "$INSTALL_DIR/VERSION")"
        else
            echo "WPCloud Control Panel Version: Unknown"
        fi
        ;;
    port)
        if [ "$EUID" -ne 0 ]; then
            echo "[-] Vui lòng chạy lệnh này với quyền root: sudo wpc port <cổng_mới>"
            exit 1
        fi
        NEW_PORT="${2:-}"
        if [ -z "$NEW_PORT" ] || ! [[ "$NEW_PORT" =~ ^[0-9]+$ ]] || [ "$NEW_PORT" -lt 1 ] || [ "$NEW_PORT" -gt 65535 ]; then
            echo "[-] Vui lòng nhập số cổng hợp lệ (từ 1 đến 65535). Ví dụ: sudo wpc port 8889"
            exit 1
        fi
        
        # Kiểm tra xem cổng mới có đang bị chiếm dụng không
        if command -v ss >/dev/null 2>&1; then
            PORT_IN_USE=$(ss -tulpn | grep ":$NEW_PORT " || true)
        elif command -v netstat >/dev/null 2>&1; then
            PORT_IN_USE=$(netstat -tulpn | grep ":$NEW_PORT " || true)
        else
            PORT_IN_USE=""
        fi

        if [ -n "$PORT_IN_USE" ]; then
            echo "[!] Cảnh báo: Cổng $NEW_PORT dường như đang bị tiến trình khác chiếm dụng!"
            echo "$PORT_IN_USE"
            read -p "Bạn có chắc chắn vẫn muốn gán cổng này? (y/N): " CONFIRM
            if [[ ! "$CONFIRM" =~ ^[yY]$ ]]; then
                echo "[-] Đã hủy thao tác đổi cổng."
                exit 1
            fi
        fi

        echo "[+] Đang cập nhật cổng sang $NEW_PORT trong $CONF_FILE..."
        if [ -f "$CONF_FILE" ]; then
            if grep -q "^port=" "$CONF_FILE"; then
                sed -i "s/^port=.*/port=$NEW_PORT/" "$CONF_FILE"
            else
                echo "port=$NEW_PORT" >> "$CONF_FILE"
            fi
        fi

        echo "[+] Khởi động lại dịch vụ WPCloud Panel..."
        systemctl restart wpc
        echo "=========================================================="
        echo "   ĐÃ ĐỔI CỔNG THÀNH CÔNG SANG: $NEW_PORT                 "
        echo "   Đường dẫn truy cập mới: http://<IP_MAY_CHU>:$NEW_PORT "
        echo "=========================================================="
        ;;
    password)
        if [ "$EUID" -ne 0 ]; then
            echo "[-] Vui lòng chạy lệnh này với quyền root: sudo wpc password"
            exit 1
        fi
        read -s -p "Nhập mật khẩu mới cho tài khoản admin: " NEW_PASS
        echo ""
        if [ -z "$NEW_PASS" ]; then
            echo "[-] Mật khẩu không được để trống!"
            exit 1
        fi
        cd "$INSTALL_DIR"
        PYTHONPATH="$INSTALL_DIR" "$INSTALL_DIR/venv/bin/python" -c "
import asyncio, aiosqlite
from app.core.security import get_password_hash
from app.core.config import settings

async def reset_pass():
    hashed = get_password_hash('$NEW_PASS')
    async with aiosqlite.connect(settings.DB_PATH) as db:
        await db.execute('UPDATE users SET password_hash = ? WHERE username = ?', (hashed, 'admin'))
        await db.commit()
    print('[+] Đã đổi mật khẩu tài khoản admin thành công!')

asyncio.run(reset_pass())
"
        ;;
    fix-perms)
        if [ "$EUID" -ne 0 ]; then
            echo "[-] Vui lòng chạy lệnh này với quyền root: sudo wpc fix-perms"
            exit 1
        fi
        echo "[+] Đang rà soát và khóa quyền bảo mật thư mục người dùng (/home/*)..."
        chmod 711 /home 2>/dev/null || true

        for user_home in /home/*; do
            [ -d "$user_home" ] || continue
            u_name=$(basename "$user_home")
            
            owner_u=$(stat -c '%U' "$user_home" 2>/dev/null || echo "$u_name")
            owner_g=$(stat -c '%G' "$user_home" 2>/dev/null || echo "$u_name")

            for grp in "$u_name" "$owner_g" "$owner_u"; do
                if getent group "$grp" &>/dev/null; then
                    for svc_u in wpc nobody www-data; do
                        id "$svc_u" &>/dev/null && usermod -a -G "$grp" "$svc_u" 2>/dev/null || true
                    done
                fi
            done

            chmod 750 "$user_home" 2>/dev/null || true
            for priv_dir in "$user_home/logs" "$user_home/ssl" "$user_home/backups" "$user_home/.tmp" "$user_home/.sessions" "$user_home/.ssh" "$user_home/tmp"; do
                [ -d "$priv_dir" ] && chmod 700 "$priv_dir" 2>/dev/null || true
            done

            if [ -d "$user_home/domains" ]; then
                find "$user_home/domains" -type d -exec chmod 755 {} + 2>/dev/null || true
                find "$user_home/domains" -type f -exec chmod 644 {} + 2>/dev/null || true
                find "$user_home/domains" -type d \( -name "logs" -o -name "ssl" -o -name "backups" \) -exec chmod 700 {} + 2>/dev/null || true
            fi
            if [ -d "$user_home/public_html" ]; then
                chmod 755 "$user_home/public_html" 2>/dev/null || true
                find "$user_home/public_html" -type d -exec chmod 755 {} + 2>/dev/null || true
                find "$user_home/public_html" -type f -exec chmod 644 {} + 2>/dev/null || true
            fi
            echo "    [-] Đã chuẩn hoá phân quyền bảo mật cho: $u_name (owner: $owner_u:$owner_g)"
        done

        if systemctl is-active --quiet lsws 2>/dev/null; then
            systemctl restart lsws 2>/dev/null || true
        elif [ -x "/usr/local/lsws/bin/lswsctrl" ]; then
            /usr/local/lsws/bin/lswsctrl restart 2>/dev/null || true
        fi
        if systemctl is-active --quiet nginx 2>/dev/null; then
            systemctl restart nginx 2>/dev/null || true
        fi
        echo "[+] Hoàn tất! Tất cả thư mục người dùng đã được cô lập an toàn và website hoạt động trơn tru."
        ;;
    help|--help|-h)
        show_help
        ;;
    *)
        echo "[-] Lệnh không hợp lệ: $ACTION"
        show_help
        exit 1
        ;;
esac
