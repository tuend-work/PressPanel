#!/usr/bin/env bash
# ==============================================================================
# WPCloud Control Panel CLI Management Tool
# Cài đặt tại: /usr/local/bin/wpc (và symlink /usr/local/bin/presspanel)
# Cách dùng: wpc <update|reinstall|status|restart|stop|start|logs|version|password|port>
# ==============================================================================

set -euo pipefail

INSTALL_DIR="/opt/wpc"
CONF_FILE="$INSTALL_DIR/conf/presspanel.conf"
[ -f "$INSTALL_DIR/conf/wpc.conf" ] && CONF_FILE="$INSTALL_DIR/conf/wpc.conf"

function show_help() {
    echo "=========================================================="
    echo "     WPCLOUD CONTROL PANEL CLI - ĐIỀU KHIỂN HỆ THỐNG     "
    echo "=========================================================="
    echo "Sử dụng: wpc <lệnh> [tham số]"
    echo ""
    echo "Các lệnh hỗ trợ:"
    echo "  update      - Cập nhật panel lên phiên bản mới nhất từ GitHub"
    echo "  reinstall   - Cài đặt lại toàn bộ panel (tự động sao lưu dữ liệu)"
    echo "  status      - Xem trạng thái dịch vụ panel"
    echo "  restart     - Khởi động lại dịch vụ panel"
    echo "  start       - Bật dịch vụ panel"
    echo "  stop        - Dừng dịch vụ panel"
    echo "  logs        - Theo dõi nhật ký hoạt động thời gian thực"
    echo "  version     - Xem phiên bản hiện tại của WPCloud Panel"
    echo "  password    - Đổi mật khẩu tài khoản quản trị admin"
    echo "  port <số>   - Đổi cổng truy cập panel (tránh trùng cổng khác)"
    echo "  help        - Hiển thị menu hướng dẫn này"
    echo "=========================================================="
}

ACTION="${1:-help}"

case "$ACTION" in
    update)
        sudo bash "$INSTALL_DIR/scripts/update.sh"
        ;;
    reinstall)
        sudo bash "$INSTALL_DIR/scripts/reinstall.sh"
        ;;
    status)
        sudo systemctl status wpc 2>/dev/null || sudo systemctl status presspanel
        ;;
    restart)
        echo "[+] Đang khởi động lại dịch vụ WPCloud Control Panel..."
        sudo systemctl restart wpc 2>/dev/null || sudo systemctl restart presspanel
        echo "[+] Hoàn tất! Trạng thái: $(systemctl is-active wpc 2>/dev/null || systemctl is-active presspanel)"
        ;;
    start)
        echo "[+] Đang bật dịch vụ WPCloud Control Panel..."
        sudo systemctl start wpc 2>/dev/null || sudo systemctl start presspanel
        echo "[+] Hoàn tất! Trạng thái: $(systemctl is-active wpc 2>/dev/null || systemctl is-active presspanel)"
        ;;
    stop)
        echo "[+] Đang dừng dịch vụ WPCloud Control Panel..."
        sudo systemctl stop wpc 2>/dev/null || sudo systemctl stop presspanel
        echo "[+] Hoàn tất!"
        ;;
    logs)
        sudo journalctl -u wpc -u presspanel -f
        ;;
    version)
        if [ -f "$INSTALL_DIR/VERSION" ]; then
            echo "WPCloud Control Panel Version: $(cat "$INSTALL_DIR/VERSION")"
        else
            echo "WPCloud Control Panel Version: Unknown"
        fi
        ;;
    port)
        if [ "$EUID" -ne 0 ]; then
            echo "[-] Vui lòng chạy lệnh này với quyền root: sudo wpc port <cổng_mới>"
            exit 1
        fi
        NEW_PORT="${2:-}"
        if [ -z "$NEW_PORT" ] || ! [[ "$NEW_PORT" =~ ^[0-9]+$ ]] || [ "$NEW_PORT" -lt 1 ] || [ "$NEW_PORT" -gt 65535 ]; then
            echo "[-] Vui lòng nhập số cổng hợp lệ (từ 1 đến 65535). Ví dụ: sudo wpc port 8889"
            exit 1
        fi
        
        # Kiểm tra xem cổng mới có đang bị chiếm dụng không
        if command -v ss >/dev/null 2>&1; then
            PORT_IN_USE=$(ss -tulpn | grep ":$NEW_PORT " || true)
        elif command -v netstat >/dev/null 2>&1; then
            PORT_IN_USE=$(netstat -tulpn | grep ":$NEW_PORT " || true)
        else
            PORT_IN_USE=""
        fi

        if [ -n "$PORT_IN_USE" ]; then
            echo "[!] Cảnh báo: Cổng $NEW_PORT dường như đang bị tiến trình khác chiếm dụng!"
            echo "$PORT_IN_USE"
            read -p "Bạn có chắc chắn vẫn muốn gán cổng này? (y/N): " CONFIRM
            if [[ ! "$CONFIRM" =~ ^[yY]$ ]]; then
                echo "[-] Đã hủy thao tác đổi cổng."
                exit 1
            fi
        fi

        echo "[+] Đang cập nhật cổng sang $NEW_PORT trong $CONF_FILE..."
        if [ -f "$CONF_FILE" ]; then
            if grep -q "^port=" "$CONF_FILE"; then
                sed -i "s/^port=.*/port=$NEW_PORT/" "$CONF_FILE"
            else
                echo "port=$NEW_PORT" >> "$CONF_FILE"
            fi
        fi

        echo "[+] Khởi động lại dịch vụ WPCloud Panel..."
        systemctl restart wpc 2>/dev/null || systemctl restart presspanel
        echo "=========================================================="
        echo "   ĐÃ ĐỔI CỔNG THÀNH CÔNG SANG: $NEW_PORT                 "
        echo "   Đường dẫn truy cập mới: http://<IP_MAY_CHU>:$NEW_PORT "
        echo "=========================================================="
        ;;
    password)
        if [ "$EUID" -ne 0 ]; then
            echo "[-] Vui lòng chạy lệnh này với quyền root: sudo wpc password"
            exit 1
        fi
        read -s -p "Nhập mật khẩu mới cho tài khoản admin: " NEW_PASS
        echo ""
        if [ -z "$NEW_PASS" ]; then
            echo "[-] Mật khẩu không được để trống!"
            exit 1
        fi
        cd "$INSTALL_DIR"
        PYTHONPATH="$INSTALL_DIR" "$INSTALL_DIR/venv/bin/python" -c "
import asyncio, aiosqlite
from app.core.security import get_password_hash
from app.core.config import settings

async def reset_pass():
    hashed = get_password_hash('$NEW_PASS')
    async with aiosqlite.connect(settings.DB_PATH) as db:
        await db.execute('UPDATE users SET password_hash = ? WHERE username = ?', (hashed, 'admin'))
        await db.commit()
    print('[+] Đã đổi mật khẩu tài khoản admin thành công!')

asyncio.run(reset_pass())
"
        ;;
    help|--help|-h)
        show_help
        ;;
    *)
        echo "[-] Lệnh không hợp lệ: $ACTION"
        show_help
        exit 1
        ;;
esac
