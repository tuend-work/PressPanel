#!/usr/bin/env bash
# ==============================================================================
# PressPanel CLI wrapper (Forwarder to wpc for backwards compatibility)
# ==============================================================================
DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [ -f "$DIR/wpc" ]; then
    exec "$DIR/wpc" "$@"
elif [ -f "/usr/local/bin/wpc" ]; then
    exec "/usr/local/bin/wpc" "$@"
elif [ -f "/opt/wpc/scripts/wpc" ]; then
    exec "/opt/wpc/scripts/wpc" "$@"
elif [ -f "/opt/presspanel/scripts/wpc" ]; then
    exec "/opt/presspanel/scripts/wpc" "$@"
else
    echo "[-] Không tìm thấy lệnh wpc!"
    exit 1
fi
